VITE_NEXA_AI_API_URL=https://nexa-funds-ai.onrender.com
VITE_USDNEWS_AI_API_URL=https://usdnewsai.onrender.com
# Backend-only PostgreSQL connection string for persistent accounts and licenses.
DATABASE_URL=
VITE_API_BASE=https://nexafunds-app.onrender.com
USDNEWS_AI_API_URL=https://usdnewsai.onrender.com
NEXA_AI_API_URL=http://127.0.0.1:8001
NEXA_AI_TIMEOUT_MS=12000
# Required for non-loopback MT5 clients; local EA calls may use localhost without a key.
MT5_API_KEY=
# Set strong, private server-side secrets; never place these in VITE_* variables.
ADMIN_API_KEY=
# At least 32 random bytes; used only by the API to derive its Ed25519 signing key.
LICENSE_SIGNING_SECRET=
# Absolute path to the compiled MT5 .ex5 file on the backend host.
EA_DOWNLOAD_PATH=
# Streaming-platform setup: provision the private stream-media bucket in a supported Neon region.
STREAM_ADMIN_EMAIL=
STREAM_ADMIN_USER_ID=
STREAMING_PUBLIC_URL=
# Comma-separated additional trusted frontend origins, without paths.
CORS_ORIGINS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STREAM_MEDIA_BUCKET=stream-media
# These AWS-compatible variables are provided by Neon Object Storage for the linked branch.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=