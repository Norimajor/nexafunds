VITE_NEXA_AI_API_URL=https://nexa-funds-ai.onrender.com
VITE_USDNEWS_AI_API_URL=https://usdnewsai.onrender.com
# Backend-only PostgreSQL connection string for persistent accounts and licenses.
DATABASE_URL=
USDNEWS_AI_API_URL=https://usdnewsai.onrender.com
NEXA_AI_API_URL=http://127.0.0.1:8001
NEXA_AI_TIMEOUT_MS=12000
# Required for non-loopback MT5 clients; local EA calls may use localhost without a key.
MT5_API_KEY=
# Set strong, private server-side secrets; never place these in VITE_* variables.
ADMIN_API_KEY=
LICENSE_SIGNING_SECRET=
# Absolute path to the compiled MT5 .ex5 file on the backend host.
EA_DOWNLOAD_PATH=